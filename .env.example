# Copy to .env (one level above public/, never inside it) and fill in.

# Leads API that lead-webhook.php forwards form submissions to (RelevantAds)
LEADS_API_URL=
# Bearer token for the leads API, if it requires one
LEADS_API_KEY=
# site_name sent with every lead: the Duda site ID of the original site
LEADS_SITE_NAME=d8e4a61f

# Deploy target for scripts/deploy.sh (SSH)
DEPLOY_HOST=
DEPLOY_USER=
DEPLOY_PATH=/var/www/truebuiltgroupllc.com
DEPLOY_PORT=22

# Used by scripts/setup-server.sh for the Apache vhost and certbot
DOMAIN=truebuiltgroupllc.com
CERTBOT_EMAIL=

# Port for scripts/preview.sh
PREVIEW_PORT=8080
