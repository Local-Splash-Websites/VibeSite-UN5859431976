# Static copy of truebuiltgroupllc.com. HTTPS and www are handled by the proxy in front of this
# container, so there is no https/www redirect here.

Options -Indexes -MultiViews
DirectoryIndex index.html

RewriteEngine On

# The copied Duda forms post to Duda's form endpoint; handle them locally.
RewriteRule ^_dm/s/rt/actions/form/ lead-webhook.php [L]

# Clean URLs: /about.html -> /about, and serve /about from about.html
RewriteCond %{THE_REQUEST} \s/+index\.html[\s?] [NC]
RewriteRule ^ / [R=301,L]
RewriteCond %{THE_REQUEST} \s/+([^\s?]+)\.html[\s?] [NC]
RewriteRule ^ /%1 [R=301,L]
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME}.html -f
RewriteRule ^(.+)$ $1.html [L]

# Same as the live site: /home goes to the home page
RewriteRule ^home/?$ / [R=301,L]

# Duda's font stylesheet is served from a path with no extension
<FilesMatch "^css2$">
  ForceType text/css
</FilesMatch>

<FilesMatch "^\.">
  Require all denied
</FilesMatch>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/css application/javascript text/javascript application/json image/svg+xml application/xml text/plain
</IfModule>

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresDefault "access plus 1 week"
  ExpiresByType text/html "access plus 0 seconds"
</IfModule>
<IfModule mod_headers.c>
  <FilesMatch "\.html$">
    Header set Cache-Control "no-cache"
  </FilesMatch>
  Header always set X-Content-Type-Options "nosniff"
</IfModule>

AddType font/woff2 .woff2
AddType image/webp .webp
AddType video/mp4 .mp4
